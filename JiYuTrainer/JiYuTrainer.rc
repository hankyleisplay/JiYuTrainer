IDD_DIALOG_ARGEEMENT DIALOGEX 0, 0, 333, 165
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "JiYu Trainer 使用者授權合約"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "我同意並開始使用軟體",IDYES,143,126,119,14
    PUSHBUTTON      "我不同意",IDNO,266,126,53,14
    LTEXT           "免責聲明：本軟體研發初衷僅供學習與技術交流使用，",IDC_STATIC,11,13,268,10
    LTEXT           "嚴禁將本軟體用於違反法律或道德規範之行為；擅自用於不正當行為所衍生之任何後果，均由使用者自行承擔！",IDC_STATIC_RED,11,25,308,49
    LTEXT           "當您開始使用本軟體時，即代表您同意本聲明。",IDC_STATIC,11,112,161,8
    LTEXT           "本軟體商標與著作權受相關法律保護，任何人不得將本軟體用於任何商業營利用途！\n在散佈或轉發本軟體副本時，不得刪除本軟體的任何所有權聲明或商標。",IDC_STATIC,13,79,312,20
    LTEXT           "JiYuTrainer V1.7",IDC_STATIC,14,130,53,8,WS_DISABLED
END


IDD_DIALOG_AVTIP DIALOGEX 0, 0, 281, 86
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "JiYu Trainer 提示"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "確定",IDOK,224,65,50,14
    ICON            IDI_WARN,IDC_STATIC,16,15,21,20
    LTEXT           "Static",IDC_MESSAGE,44,16,205,32
    CONTROL         "不再提示",IDC_CHECK_DONOT_SHOW_AGAIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,65,48,10
END


