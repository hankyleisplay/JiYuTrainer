IDR_MAINMENU MENU
BEGIN
    POPUP "MAIN"
    BEGIN
        MENUITEM "顯示/隱藏主視窗",                    IDM_SHOWMAIN
        MENUITEM "說明",                          IDM_HELP
        MENUITEM SEPARATOR
        MENUITEM "結束軟體",                        IDM_EXIT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
