IDD_SETTINGS DIALOGEX 0, 0, 369, 251
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "軟體進階參數設定"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "取消",IDCANCEL,319,230,43,14
    LTEXT           "注意：部分設定需重新啟動軟體後方能生效\n提示：於啟動本程式時按住「Alt」鍵，即可開啟本設定對話框。",IDC_STATIC,7,225,220,19
    PUSHBUTTON      "儲存",IDC_SAVE,275,230,40,14
    CONTROL         "",IDC_TAB_SETTINGS,"SysTabControl32",0x0,7,6,355,218
END

IDD_BUGREPORT DIALOGEX 0, 0, 311, 176
STYLE DS_SETFONT | DS_SETFOREGROUND | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "很抱歉，JiYuTrainer 發生當機..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "傳送錯誤回報以協助改進軟體",IDOK,124,155,124,14
    PUSHBUTTON      "不傳送",IDCANCEL,254,155,50,14
    CONTROL         "重新啟動本軟體",IDC_REBOOT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,156,56,10
    LTEXT           "非常抱歉，JiYuTrainer 遇到問題需要關閉",IDC_STATIC,17,17,150,8
    EDITTEXT        IDC_BUGREPORT_CONTENT,7,60,297,84,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL
    LTEXT           "程式已產生一份關於此錯誤的詳細回報（不包含個人隱私資料），建議您將此報告傳送給我們，這有助於修復錯誤並提升穩定性。以下為錯誤報告內容：",IDC_STATIC,17,30,267,26
END

IDD_SETTINGS_MORE DIALOGEX 0, 0, 350, 223
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "停用軟體核心驅動程式",IDC_CHECK_INI_11,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,23,80,10
    CONTROL         "驅動層自我保護 (僅 32 位元系統有效)",IDC_CHECK_INI_12,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,38,125,10
    CONTROL         "隱藏極域端控制輸出視窗",IDC_CHECK_INI_15,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,179,132,104,10
    GROUPBOX        "本軟體驅動程式 (僅 32 位元系統有效)",IDC_STATIC,7,7,160,74
    CONTROL         "啟用嚴格視窗控制模式",IDC_CHECK_INI_14,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,134,96,10
    CONTROL         "強制清除模式 (不客氣模式)",IDC_CHECK_INI_13,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,94,56,10
    LTEXT           "是否啟用自動強制清除模式，勾選後若操作失敗將直接清除極域相關處理程序，不建議啟用",IDC_STATIC,25,106,125,26,WS_DISABLED
    LTEXT           "勾選後，螢幕左上角的極域控制輸出視窗將會隱藏",IDC_STATIC,187,145,125,19,WS_DISABLED
    LTEXT           "驅動程式可能不相容於較新系統\n若發生藍底白字當機，請在此停用驅動程式",IDC_STATIC,23,55,139,18,WS_DISABLED
    LTEXT           "勾選此選項可嚴格控制極域視窗，除了螢幕廣播視窗與黑屏視窗外，極域的其他視窗亦會受控",IDC_STATIC,25,146,125,28,WS_DISABLED
    CONTROL         "隱藏本軟體工作列圖示",IDC_CHECK_INI_17,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,179,97,96,10
    LTEXT           "隱藏本軟體工作列圖示後，您仍可使用快捷鍵顯示或隱藏主視窗",IDC_STATIC,189,109,125,18,WS_DISABLED
    CONTROL         "",IDC_HOTKEY_FK,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,242,21,80,14
    CONTROL         "",IDC_HOTKEY_SHOWHIDE,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,242,41,80,14
    LTEXT           "緊急全螢幕快捷鍵",IDC_STATIC,182,24,57,8
    RTEXT           "快速顯示/隱藏視窗快捷鍵",IDC_STATIC,187,39,50,20
    GROUPBOX        "快捷鍵",IDC_STATIC,172,7,171,74
    GROUPBOX        "程式隱藏",IDC_STATIC,172,82,171,87
    GROUPBOX        "極域附加控制",IDC_STATIC,7,81,160,96
    LTEXT           "*修改快捷鍵需重新啟動軟體後生效",IDC_STATIC,187,63,103,9,WS_DISABLED
END

IDD_SETTINGS_DEBUG DIALOGEX 0, 0, 351, 223
